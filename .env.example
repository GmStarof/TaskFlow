# Apenas desenvolvimento local: substitua por uma senha forte antes de iniciar.
TASKFLOW_DB_PASSWORD=

# Variáveis opcionais do teste de navegador. Exporte no terminal que roda o teste.
# TASKFLOW_E2E_URL=http://localhost:4200
# TASKFLOW_E2E_USER=
# TASKFLOW_E2E_PASSWORD=
# TASKFLOW_E2E_CHANNEL=chrome

# Variáveis do host e do migrador em ambientes compartilhados.
# Configure no ambiente de execução. Veja docs/operacao.md.
# ConnectionStrings__Default=
# AuthServer__CertificatePath=
# AuthServer__CertificatePassword=
# StringEncryption__DefaultPassPhrase=
